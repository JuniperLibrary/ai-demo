OPENAI_API_KEY=sk-
OPENAI_BASE_URL=https://api.openai-proxy.org/v1

OLLAMA_HOST=http://localhost:11434

DASHSCOPE_API_KEY=sk-
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# DeepSearcher 配置 - 统一使用通义千问
DEEPSEARCHER_EMBEDDING_MODEL=text-embedding-v3
DEEPSEARCHER_LLM_MODEL=qwen-plus

# Google Gemini API Key
GEMINI_API_KEY=-

# Milvus 标准版连接信息 (根据您的实际部署修改)
MILVUS_HOST=192.168.0.178
MILVUS_PORT=19530

# 如果您的 Milvus 需要认证，请设置以下两项
# MILVUS_USER="root"
# MILVUS_PASSWORD="Milvus"

# MinerU 配置
MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_API_TOKEN=..--